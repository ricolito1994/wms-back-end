APP_NAME=wms
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://ec2-3-27-44-87.ap-southeast-2.compute.amazonaws.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=wms.cb664q2s0ql0.ap-southeast-2.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=wmsdbprod
DB_USERNAME=wmsdbprod
DB_PASSWORD=wmsdatabase_2025

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Octane
OCTANE_SERVER=swoole
OCTANE_HTTPS=false  # Set to true if using HTTPS
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# Mail (example for Mailgun)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Cache + queue fallback
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Optional: Disable Telescope, Debugbar, Horizon (if installed)
TELESCOPE_ENABLED=false